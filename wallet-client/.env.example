# Local `npm run dev` → staging Express + Sapphire Devnet.
VITE_APP_ENV=dev
VITE_EXPRESS_SERVER_URL=https://express-ten-xi.vercel.app
VITE_WEB3AUTH_NETWORK=sapphire_devnet

# Hosts: staging `wallet-staging.slickbills.com`, prod `wallet.slickbills.com`.
# Vercel Production for slickbills-wallet-client-prod:
# VITE_APP_ENV=production
# VITE_EXPRESS_SERVER_URL=https://slickbills-express-prod.vercel.app
# VITE_WEB3AUTH_CLIENT_ID=<sapphire mainnet client id>
# VITE_WEB3AUTH_NETWORK=sapphire_mainnet
# Do not set VITE_WEB3AUTH_FACEBOOK_AUTH_CONNECTION_ID on Mainnet unless
# you have a custom Facebook connection (Pro). Staging defaults to slickbills-test.

# Wallet connect + Monerium SIWE use Privy at /wallet/privy-auth and /wallet/siwe.
# Dashboard: enable Google, allowlist this origin, then set:
# VITE_PRIVY_APP_ID=
